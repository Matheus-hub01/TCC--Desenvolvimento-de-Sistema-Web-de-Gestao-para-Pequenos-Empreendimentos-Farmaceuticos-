# =====================================================================
# Modelo de Configuração de Ambiente (.env.exemplo) - TCC Farmacêutico
# =====================================================================
# Copie este arquivo para .env e ajuste os valores conforme o ambiente:
# copy .env.exemplo .env

# Driver de banco de dados (firebird / mysql / etc.)
DB_DRIVER=firebird

# Configurações de Rede
# DB_HOST: host do servidor Firebird (ex: localhost, 127.0.0.1 ou IP do servidor)
# DB_PORT: porta padrão do Firebird (3050)
DB_HOST=localhost
DB_PORT=3050

# Caminho absoluto para o arquivo de banco Firebird (.FDB)
# No Windows use barras normais (/) ou duplas (\\)
# Exemplo 1: C:/Firebird/data/UNIFAR_DEMO.FDB
# Exemplo 2: C:/UNIFAR_DEMO.FDB
DB_DATABASE=C:/Firebird/data/UNIFAR_DEMO.FDB

# Credenciais de acesso:
# Opção 1: Usuário ROOT personalizado
# DB_USER=ROOT
# DB_PASSWORD=sua_senha_admin

# Opção 2: Usuário padrão SYSDBA (descomente se preferir utilizar)
DB_USER=SYSDBA
DB_PASSWORD=masterkey

# Charset do banco de dados (padrão UTF8)
DB_CHARSET=UTF8

# Ambiente da aplicação (development / production)
APP_ENV=development
APP_DEBUG=true

# Porta da Aplicação Web Local
APP_PORT=8030

# Cloudflare Tunnel (Token gerado no painel do Cloudflare Zero Trust)
CLOUDFLARE_TUNNEL_TOKEN=seu_token_cloudflare_aqui

#usuario administrador do sistema
ADMIN_USER=admin
ADMIN_PASSWORD=admin123 
